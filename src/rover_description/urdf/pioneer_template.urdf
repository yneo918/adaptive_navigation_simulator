<?xml version="1.0" ?>
<robot name="pioneer_rover">
  <link name="base_link"/>
  <link name="rover_link">
    <visual>
      <!-- REP103: X+ forward, rotated -90deg around Z from original Y+ forward mesh -->
      <origin rpy="1.57 0.0 -1.57" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/pioneer_cad_v2.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="CustomColor">
        <color rgba="{r} {g} {b} {a}"/>
      </material>
    </visual>
  </link>
  <joint name="base_to_rover" type="fixed">
    <parent link="base_link"/>
    <child link="rover_link"/>
    <origin xyz="0.0 0.0 0.02"/>
  </joint>
</robot>
